    },
    {
      "id": "research",
      "label": "بحث الجمهور (ICP)",
      "group": "الأساس",
      "skill": "market-researcher",
      "kind": "single",
      "dir": "04-research",
      "outputs": [
        "04-research/icp.md"
      ],
      "dependsOn": [
        "brand"
      ],
      "prompt": "ابني الـ ICP الكامل من محتوى الكتاب نفسه في {source} (ابدأ بالملف الأساسي {mainFile}).",
      "budgetUsd": 8
    },
    {
      "id": "bonus",
      "label": "البونصات والأوفر",
      "group": "الأوفر",
      "skill": "bonus-architect",
      "kind": "single",
      "dir": "05-offer",
      "outputs": [
        "05-offer/bonus-system.md"
      ],
      "dependsOn": [
        "research"
      ],
      "prompt": "ابني منظومة البونصات من الـ Objections Matrix في 04-research/icp.md، واستخدم البونصات الحقيقية الموجودة في {source} لو مناسبة."
    },
    {
      "id": "upsell",
      "label": "أبسيل / داونسيل",
      "group": "الأوفر",
      "skill": "upsell-downsell-architect",
      "kind": "single",
      "dir": "05-offer",
      "outputs": [
        "05-offer/upsell-downsell.md"
      ],
      "dependsOn": [
        "research"
      ],
      "prompt": "ابني الأبسيل والداونسيل من الـ ICP وbonus-system.md لو موجود."
    },
    {
      "id": "calendar",
      "label": "خطة المحتوى",
      "group": "المحتوى العضوي",
      "skill": "book-launch-planner",
      "kind": "single",
      "dir": "00-calendar",
      "outputs": [
        "00-calendar/calendar.md",
        "00-calendar/calendar.csv"
      ],
      "dependsOn": [
        "brand"
      ],
      "prompt": "ابني خطة محتوى 30 يوم (calendar.md + calendar.csv) معتمدًا على icp.md لو موجود."
