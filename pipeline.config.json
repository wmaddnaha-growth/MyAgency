    {
      "id": "copy",
      "label": "البوستات المكتوبة",
      "group": "المحتوى العضوي",
      "skill": "book-launch-writer",
      "kind": "perDay",
      "dir": "01-copy",
      "match": "file",
      "dependsOn": [
        "calendar"
      ],
      "args": "days",
      "prompt": "اكتب البوستات للأيام دي من 00-calendar/calendar.csv: {days}. كل يوم في ملف لوحده بالاسم اللي الـ Skill بتحدده (01-copy/week-N/day-N-<وصف>.md).",
      "budgetUsd": 6
    },
    {
      "id": "visuals",
      "label": "التصاميم والصور",
      "group": "المحتوى العضوي",
      "skill": "book-launch-visual-producer",
      "kind": "perDay",
      "dir": "02-visuals",
      "match": "folder",
      "dependsOn": [
        "copy"
      ],
      "gate": "توليد الصور بيصرف كريدت",
      "args": "days",
      "prompt": "اعمل الـ design spec وصورة الغلاف للأيام دي: {days}. ابدأ بعيّنة صورة واحدة لكل يوم بالكتير، ولو أداة توليد الصور مش متاحة اكتب الـ spec والـ prompts بس واذكر ده في الملخص."
    },
    {
      "id": "reels",
      "label": "الريلز (وايت بورد)",
      "group": "المحتوى العضوي",
      "skill": "whiteboard-reel-producer",
      "kind": "collection",
      "dir": "03-reels",
      "dependsOn": [
        "copy"
      ],
      "gate": "شغل كود يدوي بطيء",
      "args": "days",
      "prompt": "اعمل فيديو وايت بورد لريل اليوم/الأيام دي: {days}، وحطه في 03-reels/ حسب الـ Skill.",
      "extraTools": [
        "Bash(npx remotion:*)",
        "Bash(cd whiteboard-video:*)",
        "Bash(ls:*)",
        "Bash(mkdir:*)",
        "Bash(cp:*)"
      ],
      "budgetUsd": 10
    },
    {
      "id": "landing",
      "label": "اللاندنج بيدج",
      "group": "البيع",
      "skill": "landing-page-architect",
      "kind": "single",
      "dir": "06-landing-page",
      "outputs": [
        "06-landing-page/landing-page.md"
      ],
      "dependsOn": [
        "research",
        "bonus"
      ],
      "gate": "بيتعمل لما يبقى في قرار بيع فعلي",
      "prompt": "اكتب صفحة البيع الكاملة من icp.md و05-offer/ ومحتوى الكتاب."
    },
    {
      "id": "ads",
      "label": "كوبي الإعلانات",
      "group": "البيع",
      "skill": "ad-copywriter",
      "kind": "single",
      "dir": "07-ads",
      "outputs": [
        "07-ads/ad-copies.md"
      ],
      "dependsOn": [
        "research"
      ],
      "gate": "بيتعمل لما يبقى في قرار بيع فعلي",
      "prompt": "اكتب كوبي الإعلانات من icp.md ومحتوى الكتاب."
    },
    {
      "id": "performance",
      "label": "كرييتيف الميديا باينج",
      "group": "البيع",
      "skill": "performance-creative-strategist",
      "kind": "single",
      "dir": "08-performance-creative",
      "outputs": [
        "08-performance-creative/performance-creative-machine.md"
      ],
      "dependsOn": [
        "research"
      ],
      "gate": "بس لو في نية صرف ميديا فعلية",
      "prompt": "ابني نظام الكرييتيف الكامل للميديا باينج من icp.md.",
      "budgetUsd": 10
    }
  ],
  "runner": {
    "$comment": "تشغيل الـ Skills من الداشبورد عبر claude -p (headless). الصلاحيات مقصودة تكون ضيقة: تعديل ملفات بس + أدوات قراءة، وأي Bash لازم يتضاف صريح لكل مرحلة.",
